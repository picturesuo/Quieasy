{
  "manifest_version": 3,
  "name": "Quieasy",
  "version": "0.0.0",
  "description": "For open-resource quizzes: looks up each question with your own AI key and web search, and shows a faint dot on its answer on hover.",
  "minimum_chrome_version": "140",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://*.instructure.com/*", "https://api.anthropic.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Quieasy is off",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "enable": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Turn Quieasy on (and read this tab)"
    },
    "disable": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Turn Quieasy off"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open the answer key"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
